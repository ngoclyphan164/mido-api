# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# CORS — CHỈ liên quan tới client chạy trong browser (Expo web, web dashboard).
# App native iOS/Android không gửi header Origin nên biến này không ảnh hưởng gì tới nó.
# Để trống = chặn mọi browser origin. Dùng `*` chỉ ở local.
# Đừng bỏ deep link scheme (mido://) vào đây, nó không phải CORS origin.
ALLOWED_ORIGINS=http://localhost:8081

# Bí mật cho các route /v1/cron/* — Vercel Cron gửi qua header Authorization
CRON_SECRET=

# ── Phase 1 trở đi (chưa dùng ở Phase 0) ──────────────────────────────────────
# Supabase
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Runtime dùng Supavisor transaction pooler (port 6543) + postgres.js prepare:false
# DATABASE_URL=postgresql://postgres.<ref>:<pwd>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Migration dùng direct connection (port 5432)
# DIRECT_URL=postgresql://postgres.<ref>:<pwd>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Google Maps Platform — bật Places API (New) + Routes API
# GOOGLE_MAPS_API_KEY=
