# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# CORS — CHỈ liên quan tới client chạy trong browser (Expo web, web dashboard).
# App native iOS/Android không gửi header Origin nên biến này không ảnh hưởng gì tới nó.
# Để trống = chặn mọi browser origin. Dùng `*` chỉ ở local.
# Đừng bỏ deep link scheme (mido://) vào đây, nó không phải CORS origin.
ALLOWED_ORIGINS=

# Bí mật cho các route /v1/cron/* — Vercel Cron gửi qua header Authorization
CRON_SECRET=

# ── Supabase / Postgres ───────────────────────────────────────────────────────
# URL dùng để verify access token qua JWKS và gọi Supabase Admin API.
DATABASE_SUPABASE_URL=https://<project-ref>.supabase.co
# Secret chỉ dành cho backend, cần cho DELETE /v1/auth/me. Không bao giờ đặt
# trong EXPO_PUBLIC_* hoặc commit giá trị thật vào git.
DATABASE_SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Runtime dùng Supavisor transaction pooler (port 6543) + postgres.js prepare:false
DATABASE_POSTGRES_URL=postgresql://postgres.<ref>:<pwd>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_POOL_SIZE=3

# Chỉ dùng local/CI khi chạy Drizzle migration; không cần set trên Vercel runtime.
# Direct endpoint là IPv6. Nếu máy/CI chỉ có IPv4, dùng Supavisor session mode
# aws-0-<region>.pooler.supabase.com:5432 thay thế.
DATABASE_POSTGRES_URL_NON_POOLING=postgresql://postgres:<pwd>@db.<ref>.supabase.co:5432/postgres

# Provider cho pipeline suggest. MapVina là mặc định; dùng google chỉ khi đã bật billing
# và Places API (New) + Routes API trong Google Cloud.
MAPS_PROVIDER=mapvina

# Google Maps Platform — optional fallback khi MAPS_PROVIDER=google
# GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_TIMEOUT_MS=8000
# Budget best-effort trên mỗi Vercel instance. Cấu hình quota cứng và billing alert
# riêng trong Google Cloud Console vì serverless có thể có nhiều instance.
GOOGLE_PLACES_DAILY_REQUEST_LIMIT=500
# Place Details chạy một lần cho mỗi kèo được chốt, để chụp snapshot địa điểm.
GOOGLE_PLACE_DETAILS_DAILY_REQUEST_LIMIT=500
GOOGLE_ROUTES_DAILY_ELEMENT_LIMIT=10000
GOOGLE_CIRCUIT_FAILURE_THRESHOLD=3
GOOGLE_CIRCUIT_RESET_MS=30000

# MapVina Search/Nearby/Detail/Matrix — local/test tự dùng public_key giới hạn nếu bỏ trống.
# Production phải dùng key riêng lấy từ MapVina.
# MAPVINA_API_KEY=
MAPVINA_TIMEOUT_MS=8000
MAPVINA_DAILY_REQUEST_LIMIT=500
MAPVINA_NEARBY_DAILY_REQUEST_LIMIT=500
MAPVINA_PLACE_DETAIL_LIMIT=10
MAPVINA_MATRIX_DAILY_ELEMENT_LIMIT=10000
